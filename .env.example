# ==========================================
# SCHIELE PROJECT ENVIRONMENT VARIABLES
# ==========================================
# Скопируйте этот файл в .env и заполните своими ключами.
# Никогда не коммитьте файл .env в Git!

# --- SUPABASE (Database & Auth) ---
# Получите эти значения в настройках вашего проекта на https://supabase.com
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Для серверных операций (импорт датасетов и т.д.)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# --- GROQ API (AI Query Processing - Llama) ---
# Бесплатный тариф доступен при регистрации на https://console.groq.com
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="llama-3.1-70b-versatile"

# --- GEMINI API (Creative Quotes & Analysis) ---
# Бесплатный тариф доступен при регистрации на https://aistudio.google.com
GEMINI_API_KEY="your-gemini-api-key-here"

# --- OPENROUTER API (Vision AI - Nvidia Nemotron) ---
# Регистрация на https://openrouter.ai
OPENROUTER_API_KEY="sk-or-your-openrouter-key-here"
VISION_MODEL="nvidia/nemotron-nano-12b-v2-vl:free"

# --- OLLAMA (Local AI - Опционально) ---
# Если используете локальную модель для Overseer (требуется установленный Ollama)
# Оставьте пустым или закомментируйте, если не используется
OLLAMA_URL="http://localhost:11434"

# --- NEXTAUTH (Authentication) ---
# Сгенерируйте случайную строку для секрета (например: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000" # Замените на ваш домен в продакшене
